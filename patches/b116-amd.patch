+                 static_cast<double>(stats.copies) / seconds,
+                 static_cast<double>(stats.slots) / seconds,
+                 static_cast<double>(stats.queries) / seconds,
+                 static_cast<double>(stats.multi) / seconds, stats.max_copy);
+        stats = CopyStats{.start = now};
+    }
