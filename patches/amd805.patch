From e01e873176cb20804a2c558638dc55525d7d3cf9 Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Sun, 8 Nov 2026 17:51:04 +0000
Subject: [PATCH 6/7] vk_scheduler: EDEN_NX2_RP_BARRIER full barriers around
 render passes (from Lichii-AMD 01df45eb)

---
 .../renderer_vulkan/vk_scheduler.cpp          | 34 +++++++++++++++++--
 1 file changed, 32 insertions(+), 2 deletions(-)

diff --git a/src/video_core/renderer_vulkan/vk_scheduler.cpp b/src/video_core/renderer_vulkan/vk_scheduler.cpp
index d03209eb..a63f1823 100644
--- a/src/video_core/renderer_vulkan/vk_scheduler.cpp
+++ b/src/video_core/renderer_vulkan/vk_scheduler.cpp
@@ -45,6 +45,28 @@
 namespace Vulkan {
 
 namespace {
+/// EDEN_NX2_RP_BARRIER=1 (Lichii-AMD): a full memory barrier before every render pass begins and
+/// after it ends. Ocarina's minimap, hearts and dialogs vanish on about half of the frames on AMD
+/// without it.
+bool FullRenderPassBarriers() {
+    static const bool enabled = [] {
+        const char* const value = std::getenv("EDEN_NX2_RP_BARRIER");
+        return value != nullptr && value[0] == '1';
+    }();
+    return enabled;
+}
+
+void RecordFullBarrier(vk::CommandBuffer cmdbuf) {
+    static constexpr VkMemoryBarrier FULL_BARRIER{
+        .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+        .pNext = nullptr,
+        .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT,
+        .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT,
+    };
+    cmdbuf.PipelineBarrier(VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                           0, FULL_BARRIER);
+}
+
 std::atomic<u64> g_profile_submits{};
 std::atomic<u64> g_profile_renderpasses{};
 std::atomic<u64> g_profile_finishes{};
@@ -634,7 +656,11 @@ void Scheduler::BeginRenderPassImpl(const Framebuffer* framebuffer, VkRenderPass
     }
     const bool after_compute = std::exchange(compute_writes_pending, false);
     RecordAs([renderpass, framebuffer_handle, render_area, values, clear_value_count,
-              after_compute](vk::CommandBuffer cmdbuf, vk::CommandBuffer) {
+              after_compute, full_barrier = FullRenderPassBarriers()](vk::CommandBuffer cmdbuf,
+                                                                      vk::CommandBuffer) {
+        if (full_barrier) {
+            RecordFullBarrier(cmdbuf);
+        }
         const VkRenderPassBeginInfo renderpass_bi{
             .sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO,
             .pNext = nullptr,
@@ -1262,7 +1288,8 @@ void Scheduler::EndRenderPass(std::source_location cause)
         RecordAs([num_images = num_renderpass_images,
                        images = renderpass_images,
                        ranges = renderpass_image_ranges,
-                       has_transform_feedback = device.IsExtTransformFeedbackSupported()](
+                       has_transform_feedback = device.IsExtTransformFeedbackSupported(),
+                       full_barrier = FullRenderPassBarriers()](
                           vk::CommandBuffer cmdbuf, vk::CommandBuffer) {
             std::array<VkImageMemoryBarrier, 9> barriers;
             for (size_t i = 0; i < num_images; ++i) {
@@ -1314,6 +1341,9 @@ void Scheduler::EndRenderPass(std::source_location cause)
                                        VK_PIPELINE_STAGE_VERTEX_INPUT_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
                                        0, XFB_OUTPUT_BARRIER);
             }
+            if (full_barrier) {
+                RecordFullBarrier(cmdbuf);
+            }
         }, cause, RecordSite::PassEnd, site_flags);
 
         state.renderpass = VkRenderPass{};
